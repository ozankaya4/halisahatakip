# ---------------------------------------------------------------------------
# Halısaha Takip — SUNUCU ayarları (kurulum betiği için)
#
# Bu dosya yalnızca kurulum.sh'ın kullandığı iki değeri tutar.
# Uygulamanın kendi ayarları /srv/halisaha/.env dosyasında.
#
#     cp deploy/sunucu.env.ornek deploy/sunucu.env
#     nano deploy/sunucu.env
#
# deploy/sunucu.env .gitignore'da; ASLA commit etmeyin.
# ---------------------------------------------------------------------------

# Satın aldığınız alan adı, başında https:// veya www. OLMADAN.
ALAN_ADI=halisahadefteri.site

# PostgreSQL kullanıcısının parolası. Rastgele üretin:
#   openssl rand -base64 32
DB_PAROLA=
