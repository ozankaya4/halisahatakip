# Depo Windows'ta geliştirilip Linux sunucuda çalışıyor.
#
# Kabuk betikleri ve sunucu yapılandırmaları LF ile kalmalı. CRLF satır
# sonuyla checkout edilen bir bash betiği sunucuda şu hatayı verir:
#     /srv/halisaha/deploy/kurulum.sh: line 2: $'\r': command not found
# Sebebi anlaşılması zor olduğu için burada kilitliyoruz.

* text=auto eol=lf

*.sh        text eol=lf
*.conf      text eol=lf
*.service   text eol=lf
*.py        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.md        text eol=lf
*.env       text eol=lf
*.ornek     text eol=lf

# İkili dosyalar dönüştürülmesin.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.woff      binary
*.woff2     binary
*.gz        binary
*.br        binary
