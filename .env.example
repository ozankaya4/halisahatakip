# ---------------------------------------------------------------------------
# Halısaha Takip — ortam değişkenleri örneği
#
# Bu dosyayı ".env" adıyla kopyalayın ve değerleri doldurun.
# .env dosyası .gitignore'da; ASLA commit etmeyin.
#
#   copy .env.example .env
#
# SECRET_KEY üretmek için:
#   .venv\Scripts\python.exe -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# ---------------------------------------------------------------------------

SECRET_KEY=buraya-uretilen-anahtari-yapistirin
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Üretimde alan adınızı ekleyin (şema dahil):
# CSRF_TRUSTED_ORIGINS=https://halisaha.example.com

# --- Veritabanı ------------------------------------------------------------
# Boş bırakılırsa yerel SQLite kullanılır.
# PostgreSQL örneği:
# DATABASE_URL=postgres://kullanici:parola@localhost:5432/halisaha
# DB_SSLMODE=require

# --- Google ile giriş ------------------------------------------------------
# https://console.cloud.google.com/apis/credentials adresinden
# "OAuth 2.0 Client ID" (Web application) oluşturun.
#
# Yetkili yönlendirme URI'si (geliştirme):
#   http://127.0.0.1:8000/hesap/google/login/callback/
# Yetkili yönlendirme URI'si (üretim):
#   https://ALAN-ADINIZ/hesap/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- İlk yönetici (ultimate admin) -----------------------------------------
# "python manage.py ilk_yonetici" komutu bu değerleri okur.
# Komutu çalıştırdıktan sonra parolayı bu dosyadan silmeniz önerilir.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=

# --- E-posta ---------------------------------------------------------------
# Geliştirmede e-postalar konsola yazılır. Üretim için SMTP bilgilerini girin.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Halısaha Takip <noreply@localhost>

# E-posta doğrulaması.
#   none      : doğrulama istenmez, kayıttan sonra doğrudan giriş (GELİŞTİRME)
#   optional  : doğrulama e-postası gider ama zorunlu değildir
#   mandatory : doğrulanmadan giriş yapılamaz (ÜRETİM)
#
# ⚠️ Üretimde "none" bırakmayın. O hâlde herkes, sahibi olmadığı bir adresle
# kayıt olup anında giriş yapabilir; adresin gerçek sahibi hiçbir şey görmez
# ve ACCOUNT_UNIQUE_EMAIL yüzünden kendi adresiyle bir daha kayıt olamaz.
# "mandatory" seçmeden ÖNCE çalışan bir SMTP kurun, yoksa kimse kayıt olamaz.
# "manage.py check --deploy" bu satır eksikken halisaha.W001 uyarısı verir.
EMAIL_VERIFICATION=none

# --- Üretim güvenliği ------------------------------------------------------
# HTTPS ile yayına aldığınızda ikisini de True yapın.
SECURE_SSL_REDIRECT=False
BEHIND_PROXY=False

# nginx kullanıyorsanız korumalı dosya sunumunu nginx'e devretmek için True.
USE_X_ACCEL_REDIRECT=False

# Profil sayfaları giriş yapmamış ziyaretçilere de açık olsun mu?
PUBLIC_PROFILES=False

# Gizlilik politikasında ve Play Store kaydında görünen iletişim adresi.
CONTACT_EMAIL=hikmetozankaya@gmail.com

# ---------------------------------------------------------------------------
# Android uygulaması (Play Store)
# ---------------------------------------------------------------------------
# Play'deki uygulama bu siteyi tam ekran açan bir TWA. Android, adres
# çubuğunu ancak /.well-known/assetlinks.json dosyasında uygulamanın paket
# adını ve imza parmak izini bulursa gizler.
#
# Parmak izini ilk yüklemeden ÖNCE bilemezsiniz: Google uygulamayı kendi
# anahtarıyla yeniden imzalar. Sıra şu:
#   1. Bu iki satır boşken uygulamayı Play Console'a yükleyin
#   2. Play Console > Test et ve yayınla > Uygulama bütünlüğü sayfasından
#      SHA-256 parmak izini kopyalayın
#   3. Buraya yapıştırıp sunucuyu yeniden başlatın
#
# Birden çok parmak izi virgülle ayrılır (Google'ın imzası + kendi
# yükleme anahtarınız); ikisini birden yazmak yerel testte de çalışmasını
# sağlar.
ANDROID_PACKAGE_NAME=
ANDROID_SIGNING_FINGERPRINTS=
