# ---------------------------------------------------------------------------
# Halısaha Takip — ortam değişkenleri örneği
#
# Bu dosyayı ".env" adıyla kopyalayın ve değerleri doldurun.
# .env dosyası .gitignore'da; ASLA commit etmeyin.
#
#   copy .env.example .env
#
# SECRET_KEY üretmek için:
#   .venv\Scripts\python.exe -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# ---------------------------------------------------------------------------

SECRET_KEY=buraya-uretilen-anahtari-yapistirin
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Üretimde alan adınızı ekleyin (şema dahil):
# CSRF_TRUSTED_ORIGINS=https://halisaha.example.com

# --- Veritabanı ------------------------------------------------------------
# Boş bırakılırsa yerel SQLite kullanılır.
# PostgreSQL örneği:
# DATABASE_URL=postgres://kullanici:parola@localhost:5432/halisaha
# DB_SSLMODE=require

# --- Google ile giriş ------------------------------------------------------
# https://console.cloud.google.com/apis/credentials adresinden
# "OAuth 2.0 Client ID" (Web application) oluşturun.
#
# Yetkili yönlendirme URI'si (geliştirme):
#   http://127.0.0.1:8000/hesap/google/login/callback/
# Yetkili yönlendirme URI'si (üretim):
#   https://ALAN-ADINIZ/hesap/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- İlk yönetici (ultimate admin) -----------------------------------------
# "python manage.py ilk_yonetici" komutu bu değerleri okur.
# Komutu çalıştırdıktan sonra parolayı bu dosyadan silmeniz önerilir.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=

# --- E-posta ---------------------------------------------------------------
# Geliştirmede e-postalar konsola yazılır. Üretim için SMTP bilgilerini girin.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Halısaha Takip <noreply@localhost>

# --- Üretim güvenliği ------------------------------------------------------
# HTTPS ile yayına aldığınızda ikisini de True yapın.
SECURE_SSL_REDIRECT=False
BEHIND_PROXY=False

# nginx kullanıyorsanız korumalı dosya sunumunu nginx'e devretmek için True.
USE_X_ACCEL_REDIRECT=False

# Profil sayfaları giriş yapmamış ziyaretçilere de açık olsun mu?
PUBLIC_PROFILES=False
