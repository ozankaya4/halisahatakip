{% load static %}{
  "id": "/",
  "name": "Halısaha Defteri",
  "short_name": "Halısaha Defteri",
  "description": "Halı saha maçlarını, kadroları ve oyuncu puanlarını takip eden grup defteri.",
  "lang": "tr",
  "dir": "ltr",

  "start_url": "/panel/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",

  "background_color": "#f6f3ea",
  "theme_color": "#1f4d38",

  "icons": [
    {
      "src": "{% static 'img/ikon-192.png' %}",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "{% static 'img/ikon-512.png' %}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "{% static 'img/ikon-maskable-192.png' %}",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "{% static 'img/ikon-maskable-512.png' %}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],

  "shortcuts": [
    {
      "name": "Panel",
      "url": "/panel/"
    },
    {
      "name": "Gruplarım",
      "url": "/gruplar/"
    }
  ]
}
